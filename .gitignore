# Source PDFs handed over with the task; docs/ARCHITECTURE.md is the tracked copy.
/*.pdf

# Build output
/bin/
/citadel
*.test
*.out
coverage.*

# Keys generated by `make keys` or `citadel keygen` (test vectors live in testdata/vectors/)
/keys/

# Generated runs: only the M1 trace and final results are tracked.
/runs/*
!/runs/README.md
!/runs/m1/
!/runs/results/

# Fuzz caches outside testdata
/.fuzzcache/
.DS_Store
